+/// Sum of `utxo.amount()` across `inputs`. Split out of `new_withdrawal_txn`
+/// so it can be summarized as a single unit — see
+/// `solvency::summaries_utxo_pool::sum_input_amounts_summary`.
+fun sum_input_amounts(inputs: &vector<Utxo>): u64 {
+    let mut input_amount = 0;
+    inputs.do_ref!(|utxo| {
+        input_amount = input_amount + utxo.amount();
+    });
+    input_amount
+}
+
+/// Sum of `utxo.amount` across `outputs`. Split out of `new_withdrawal_txn`
+/// so it can be summarized as a single unit — see
+/// `solvency::summaries_utxo_pool::sum_output_amounts_summary`.
+fun sum_output_amounts(outputs: &vector<OutputUtxo>): u64 {
+    let mut output_amount = 0;
+    outputs.do_ref!(|utxo| {
+        output_amount = output_amount + utxo.amount;
+    });
+    output_amount
+}
+
+/// Split out of `new_withdrawal_txn` so it can be summarized as a single
+/// unit — see `solvency::summaries_utxo_pool::count_requests_summary`.
+fun count_requests(request_ids: &vector<address>): u64 {
+    request_ids.length()
+}
+
+/// Split out of `new_withdrawal_txn` so it can be summarized as a single
+/// unit — see `solvency::summaries_utxo_pool::count_outputs_summary`.
+fun count_outputs(outputs: &vector<OutputUtxo>): u64 {
+    outputs.length()
+}
+
+/// Each withdrawal output must match its request's amount after deducting
+/// the per-user miner fee, at or above the dust floor, to the request's
+/// destination address. Split out of `new_withdrawal_txn` so it can be
+/// summarized as a single unit — see
+/// `solvency::summaries_utxo_pool::check_withdrawal_outputs_summary`.
+fun check_withdrawal_outputs(
+    request_count: u64,
+    request_infos: &vector<CommittedRequestInfo>,
+    outputs: &vector<OutputUtxo>,
+    per_user_miner_fee: u64,
+) {
+    request_count.do!(|i| {
+        let info = request_infos.borrow(i);
+        let output = outputs.borrow(i);
+        // Checked before subtracting, so a request smaller than its fee share
+        // aborts with the dust error instead of underflowing. The sum cannot
+        // overflow: the fee is capped at the withdrawal minimum less dust.
+        assert!(
+            info.btc_amount >= per_user_miner_fee + hashi::btc_config::dust_relay_min_value(),
+            EOutputBelowDust,
+        );
+        let expected = info.btc_amount - per_user_miner_fee;
+        assert!(output.amount == expected, EOutputAmountMismatch);
+        assert!(output.bitcoin_address == info.bitcoin_address, EOutputAddressMismatch);
+    });
+}
