+/// Lock every input UTXO of `withdrawal_txn` to `withdrawal_txn_id`. Split
+/// out of `commit_withdrawal_tx` so it can be summarized as a single unit —
+/// see `solvency::summaries_utxo_pool::lock_input_utxos_summary`.
+fun lock_input_utxos(hashi: &mut Hashi, withdrawal_txn: &WithdrawalTransaction, withdrawal_txn_id: address) {
+    withdrawal_txn.withdrawal_txn_inputs().do_ref!(|utxo| {
+        hashi.bitcoin_mut().utxo_pool_mut().lock(utxo.id(), withdrawal_txn_id);
+    });
+}
+
+/// Insert every change UTXO of `withdrawal_txn` into the pool as pending.
+/// Split out of `commit_withdrawal_tx` so it can be summarized as a single
+/// unit — see `solvency::summaries_utxo_pool::insert_change_utxos_summary`.
+fun insert_change_utxos(hashi: &mut Hashi, withdrawal_txn: &WithdrawalTransaction, withdrawal_txn_id: address) {
+    let change_utxos = hashi::withdrawal_queue::build_change_utxos(withdrawal_txn);
+    change_utxos.do!(|change_utxo| {
+        hashi.bitcoin_mut().utxo_pool_mut().insert_pending(change_utxo, withdrawal_txn_id);
+    });
+}
