+/// Check if a deposit request has been confirmed (moved to the processed
+/// bag by `insert_processed`).
+public fun contains_processed(self: &DepositRequestQueue, id: address): bool {
+    self.processed.contains(id)
+}
+
+/// Borrow the active-requests `ObjectBag` itself (not an entry in it) —
+/// lets spec code compare its identity (`sui::object::id`) against
+/// `processed_ref`'s, since they're two distinct objects in any reachable
+/// state (each gets its own fresh UID from `deposit_queue::create`), a
+/// fact a fully-nondet `DepositRequestQueue` doesn't otherwise encode.
+public fun requests_ref(self: &DepositRequestQueue): &ObjectBag {
+    &self.requests
+}
+
+/// Borrow the processed-requests `ObjectBag` itself. See `requests_ref`.
+public fun processed_ref(self: &DepositRequestQueue): &ObjectBag {
+    &self.processed
+}
