+
+// ~~~~~~~ Membership Accessors ~~~~~~~
+
+/// Is `proposal_id` an active (created, not yet executed) proposal?
+///
+/// Both bags are keyed by `ID` (`proposal::create`, `proposal::execute`).
+/// Dynamic-field keys are type-tagged, so a lookup by
+/// `id.to_address()` would silently be `false` forever.
+public fun contains_active(self: &Proposals, proposal_id: ID): bool {
+    self.active.contains(proposal_id)
+}
+
+/// Has `proposal_id` executed? See `contains_active` for the key-type note.
+public fun contains_executed(self: &Proposals, proposal_id: ID): bool {
+    self.executed.contains(proposal_id)
+}
