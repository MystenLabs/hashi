# Environment for hashi-guardian-ops. Copy it, fill it in, and pass the copy's path with --env-file.

# The guardian enclave's Pulumi program, and its stack.
GUARDIAN_PULUMI_DIR="$HOME/infra/enclave"
GUARDIAN_STACK="org/testnet"
# The guardian proxy's public URL, published on chain as guardian_url.
GUARDIAN_PROXY_URL="https://guardian.testnet.hashi.sui.io"

# The Pulumi CLI version the stacks' own automation runs. Steps that change a stack refuse any other.
PULUMI_VERSION="3.0.0"
