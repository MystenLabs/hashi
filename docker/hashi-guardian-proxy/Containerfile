# syntax=docker/dockerfile:1

# The out-of-enclave guardian proxy (wid cache, restricted forwarding,
# provisioning relay, /info), deployed as an ECS Fargate task in front of the
# enclave host. Same stage layout as docker/hashi-screener/Containerfile. The
# enclave itself is built by docker/hashi-guardian/Containerfile into an EIF,
# not an OCI image.

FROM stagex/pallet-rust@sha256:84621c4c29330c8a969489671d46227a0a43f52cdae243f5b91e95781dbfe5ed AS pallet-rust
FROM stagex/busybox@sha256:3d128909dbc8e7b6c4b8c3c31f4583f01a307907ea179934bb42c4ef056c7efd AS busybox
FROM stagex/core-filesystem@sha256:da28831927652291b0fa573092fd41c8c96ca181ea224df7bff40e1833c3db13 AS core-filesystem

#
# Deps stage: fetch and compile external dependencies (cached until Cargo.toml/Cargo.lock change)
#
FROM pallet-rust AS deps

# Shell needed by cc-based build scripts (ring, etc.)
COPY --from=busybox . /

# Copy only manifests
COPY Cargo.toml Cargo.lock /src/
COPY crates/hashi-guardian-proxy/Cargo.toml /src/crates/hashi-guardian-proxy/Cargo.toml
COPY crates/hashi-types/Cargo.toml /src/crates/hashi-types/Cargo.toml

WORKDIR /src

# Create stub source files so cargo can resolve and compile all external deps
RUN mkdir -p crates/hashi-guardian-proxy/src \
 && echo 'fn main(){}' > crates/hashi-guardian-proxy/src/main.rs \
 && touch crates/hashi-guardian-proxy/src/lib.rs \
 && mkdir -p crates/hashi-types/src \
 && touch crates/hashi-types/src/lib.rs

ENV TARGET=x86_64-unknown-linux-musl
ENV OPENSSL_STATIC=true
ENV CARGO_INCREMENTAL=0
ENV RUSTFLAGS="-C target-feature=+crt-static -C relocation-model=static -C target-cpu=x86-64"

RUN cargo fetch
RUN --network=none cargo build --release --frozen --target "$TARGET" -p hashi-guardian-proxy --bin hashi-guardian-proxy

#
# Build stage: compile with real source (only local crates recompile)
#
FROM deps AS build

COPY crates/hashi-guardian-proxy /src/crates/hashi-guardian-proxy
COPY crates/hashi-types /src/crates/hashi-types

# Touch source files to invalidate cargo's fingerprint cache for local crates
RUN find crates/ -name "*.rs" -exec touch {} +

RUN --network=none cargo build --release --frozen --target "$TARGET" -p hashi-guardian-proxy --bin hashi-guardian-proxy

#
# Package stage: minimal runtime image
#
FROM core-filesystem
# CA bundle for the AWS SDK's S3 client: aws-smithy verifies TLS through
# rustls-native-certs and core-filesystem ships no root store. The tonic
# channel to the guardian embeds webpki roots and needs none.
COPY --from=build /etc/ssl/cert.pem /etc/ssl/cert.pem
COPY --from=build /src/target/x86_64-unknown-linux-musl/release/hashi-guardian-proxy /usr/bin/hashi-guardian-proxy
ENTRYPOINT ["/usr/bin/hashi-guardian-proxy"]
