# This containerfile uses StageX (https://stagex.tools) images, which provide a
# full source bootstrapped, deterministic, and hermetic build toolchain

FROM stagex/core-ca-certificates@sha256:8390dff73a4502614411e2b2ecb4e4e33b6cc10dc26cf2c6a46e5df71f4c4b03 AS core-ca-certificates
FROM stagex/core-musl@sha256:42fd2ed18ac4d6336f08f1b6345e0bb7bc5570450a40e7255b6da79868bd2d6b AS core-musl
FROM stagex/core-busybox@sha256:e4a30addc8939c8e232472de904d1d9e97fc2e735fca9a9701ce49db04c6c181 AS core-busybox
FROM stagex/user-eif_build@sha256:8bbd8fb500322e719063645460f3942d04ca99048089adea237026443c9517b7 AS user-eif_build
FROM stagex/user-cpio@sha256:46ca4a247908c502e31a26842925b02cc7133fec619b19e0d5c3833f6d073d8e AS user-cpio
FROM stagex/user-socat@sha256:70b21dec5de83d366babfa90215ce510118df88b798d4106f429bde3bf55973a AS user-socat
FROM stagex/user-jq@sha256:1b2dddde7a2a35395430ebd99e07117bbc48fa29a0dba8a6b18d6d74bf762368 AS user-jq
# Use the published Nitro kernel and its matching config, pinned independently
# of the Rust toolchain.
FROM stagex/user-linux-nitro@sha256:edc0a74392d7b3ca904fa0e999307aabbe4a84ad780328439a2def6bdee55189 AS user-linux-nitro

# StageX's Rust 1.96 pallet supplies the compiler and supporting build tools.
FROM stagex/pallet-rust@sha256:abe9b95c93a5afa271f69fcd5eb18c8cd405fe5df6491a63c9418e3a170573dc AS base
COPY --from=user-eif_build . /
COPY --from=user-cpio . /

# Only the guardian's dependency closure goes in: hashi-guardian, hashi-types,
# root manifest, root lock. `-p` does not narrow resolution, so copying all of
# crates/ would pull test-only deps into this build, and two of them
# (`move-binary-format`, `move-core-types`) sit under a path the sui workspace
# `exclude`s, which this cargo cannot resolve (#960). `cargo fetch` narrows the
# root lock in place; the assertion after it proves that only pruned and never
# re-picked a version, so the --frozen build compiles exactly what the root
# lock pins. No build args: CI (guardian-enclave-resolve) runs just this stage.
FROM base AS resolve
COPY Cargo.toml /Cargo.toml
COPY Cargo.lock /Cargo.lock
COPY crates/hashi-guardian /crates/hashi-guardian
COPY crates/hashi-types /crates/hashi-types
WORKDIR /
RUN <<-EOF
	set -eu
	cp /Cargo.lock /root-Cargo.lock
	cargo fetch
	# One "name|version|source|checksum" tuple per [[package]]. Whole paragraphs
	# would not match: narrowing rewrites retained packages' dependency lists.
	canon() {
		in=0; n=; v=; s=; c=
		while IFS= read -r l; do
			case "$l" in
			'[[package]]')
				[ "$in" = 0 ] || printf '%s|%s|%s|%s\n' "$n" "$v" "$s" "$c"
				in=1; n=; v=; s=; c= ;;
			'['*)
				[ "$in" = 0 ] || printf '%s|%s|%s|%s\n' "$n" "$v" "$s" "$c"
				in=0 ;;
			'name = '*) [ "$in" = 0 ] || n="${l#name = }" ;;
			'version = '*) [ "$in" = 0 ] || v="${l#version = }" ;;
			'source = '*) [ "$in" = 0 ] || s="${l#source = }" ;;
			'checksum = '*) [ "$in" = 0 ] || c="${l#checksum = }" ;;
			esac
		done < "$1"
		[ "$in" = 0 ] || printf '%s|%s|%s|%s\n' "$n" "$v" "$s" "$c"
	}
	canon /root-Cargo.lock | sort > /root.pkgs
	canon /Cargo.lock | sort > /slice.pkgs
	extra="$(grep -Fxv -f /root.pkgs /slice.pkgs || true)"
	if [ -n "$extra" ]; then
		echo "ERROR: resolution picked packages the committed root Cargo.lock does not pin:" >&2
		echo "$extra" >&2
		echo "The enclave must compile exactly what the root lock records. Update" >&2
		echo "Cargo.toml and Cargo.lock together (any cargo build rewrites the lock)." >&2
		exit 1
	fi
	echo "enclave lock subset OK: $(wc -l < /slice.pkgs) of $(wc -l < /root.pkgs) root packages"
	rm /root-Cargo.lock /root.pkgs /slice.pkgs
EOF

FROM resolve AS build
ARG BUCKET_NAME
ARG AWS_REGION=us-east-1
ARG GIT_REVISION
# Extra cargo features for the guardian build. Empty (the default) is the real
# enclave build — leave it empty for anything whose PCR0 must match provenance.
# Dev deploys pass `non-enclave-dev` so a runner-local mock ceremony verifies.
ARG FEATURES=""
# Enclave boot mode, baked into run.sh below (see guardian main.rs). Empty (the
# default) => withdraw; "true" => ceremony. A ceremony enclave is intentionally a
# distinct, separately-attested EIF with its own PCR0.
ARG CEREMONY_MODE=""
RUN [ -n "$GIT_REVISION" ] || { echo "GIT_REVISION build-arg must be set"; exit 1; }
ENV GIT_REVISION=${GIT_REVISION}
ENV OPENSSL_STATIC=true
ENV TARGET=x86_64-unknown-linux-musl
ENV RUSTFLAGS="-C target-feature=+crt-static -C relocation-model=static -C target-cpu=x86-64"
RUN --network=none cargo build --frozen --no-default-features --release --target "$TARGET" -p hashi-guardian ${FEATURES:+--features "$FEATURES"}

# Keep the resolve stage kernel-free; use the published kernel directly.
COPY --from=user-linux-nitro /bzImage /bzImage
COPY --from=user-linux-nitro /linux.config /kernel.config

WORKDIR /build_cpio
ENV KBUILD_BUILD_TIMESTAMP=1
RUN mkdir -p initramfs/proc initramfs/sys initramfs/dev initramfs/tmp
COPY --from=core-busybox . initramfs
COPY --from=core-musl . initramfs
COPY --from=core-ca-certificates /etc/ssl/certs initramfs
COPY --from=core-busybox /bin/sh initramfs/sh
COPY --from=user-jq /bin/jq initramfs
COPY --from=user-socat /bin/socat . initramfs
RUN cp /target/${TARGET}/release/hashi-guardian initramfs/guardian
# run.sh is the enclave init: the kernel execs /init as PID 1.
COPY docker/hashi-guardian/run.sh initramfs/init
RUN sed -i "s/\${BUCKET_NAME}/${BUCKET_NAME}/g; s/\${AWS_REGION}/${AWS_REGION}/g; s/\${CEREMONY_MODE}/${CEREMONY_MODE}/g" initramfs/init
RUN chmod 755 initramfs/init

COPY <<-EOF initramfs/etc/environment
SSL_CERT_FILE=/ca-certificates.crt
PATH=/bin:/sbin:/usr/bin:/usr/sbin:/
EOF

RUN <<-EOF
    set -eux
    cd initramfs
    find . -exec touch -hcd "@0" "{}" + -print0 \
    | sort -z \
    | cpio \
        --null \
        --create \
        --verbose \
        --reproducible \
        --format=newc \
    | gzip --best \
    > /build_cpio/rootfs.cpio
EOF

WORKDIR /build_eif
# The Nitro loader unpacks the ramdisk as an initramfs and execs /init, so the
# cmdline carries no initrd=/root= (an old-style ramdisk-root cmdline panics the
# kernel with "Cannot open root device").
RUN eif_build \
	--kernel /bzImage \
	--kernel_config /kernel.config \
	--ramdisk /build_cpio/rootfs.cpio \
	--pcrs_output /nitro.pcrs \
	--output /nitro.eif \
	--cmdline "reboot=k panic=1 pci=off nomodules console=ttyS0 i8042.noaux i8042.nomux i8042.nopnp i8042.dumbkbd"

FROM base AS install
WORKDIR /rootfs
COPY --from=build /nitro.eif .
COPY --from=build /nitro.pcrs .
COPY --from=build /build_cpio/rootfs.cpio .
# Export the kernel and its config alongside rootfs.cpio for provenance triage.
# Comparing these inputs helps locate differences between EIF builds.
COPY --from=build /bzImage .
COPY --from=build /kernel.config .

FROM scratch AS package
COPY --from=install /rootfs .
