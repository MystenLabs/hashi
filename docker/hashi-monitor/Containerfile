# syntax=docker/dockerfile:1

# hashi-monitor, the long-running auditor that cross-checks Sui, the guardian's
# S3 withdrawal log and Bitcoin. Same stage layout as
# docker/hashi-guardian-proxy/Containerfile.

FROM stagex/pallet-rust@sha256:abe9b95c93a5afa271f69fcd5eb18c8cd405fe5df6491a63c9418e3a170573dc AS pallet-rust
FROM stagex/busybox@sha256:3d128909dbc8e7b6c4b8c3c31f4583f01a307907ea179934bb42c4ef056c7efd AS busybox
FROM stagex/core-filesystem@sha256:da28831927652291b0fa573092fd41c8c96ca181ea224df7bff40e1833c3db13 AS core-filesystem

#
# Deps stage: fetch and compile external dependencies (cached until Cargo.toml/Cargo.lock change)
#
FROM pallet-rust AS deps

# Shell needed by cc-based build scripts (ring, etc.)
COPY --from=busybox . /

# Copy only manifests
COPY Cargo.toml Cargo.lock /src/
COPY crates/hashi-monitor/Cargo.toml /src/crates/hashi-monitor/Cargo.toml
COPY crates/hashi-guardian/Cargo.toml /src/crates/hashi-guardian/Cargo.toml
COPY crates/hashi-types/Cargo.toml /src/crates/hashi-types/Cargo.toml
# Only for resolution: hashi-monitor's e2e-tests dev-dependency (and its hashi
# dependency, with hashi's own) must load, though the binary builds none of them.
COPY crates/e2e-tests/Cargo.toml /src/crates/e2e-tests/Cargo.toml
COPY crates/hashi/Cargo.toml /src/crates/hashi/Cargo.toml
COPY crates/hashi-weight-reduction-v1/Cargo.toml /src/crates/hashi-weight-reduction-v1/Cargo.toml

WORKDIR /src

# Create stub source files so cargo can resolve and compile all external deps
RUN mkdir -p crates/hashi-monitor/src crates/hashi-guardian/src crates/hashi-types/src crates/e2e-tests/src crates/hashi/src crates/hashi-weight-reduction-v1/src \
 && echo 'fn main(){}' > crates/hashi-monitor/src/main.rs \
 && touch crates/hashi-monitor/src/lib.rs \
 && touch crates/hashi-guardian/src/lib.rs \
 && touch crates/hashi-types/src/lib.rs \
 && echo 'fn main(){}' > crates/e2e-tests/src/main.rs \
 && touch crates/e2e-tests/src/lib.rs \
 && touch crates/hashi/src/lib.rs \
 && touch crates/hashi-weight-reduction-v1/src/lib.rs

ENV TARGET=x86_64-unknown-linux-musl
ENV OPENSSL_STATIC=true
ENV CARGO_INCREMENTAL=0
ENV RUSTFLAGS="-C target-feature=+crt-static -C relocation-model=static -C target-cpu=x86-64"

RUN cargo fetch
# Extra cargo features. Dev deploys pass `hashi-guardian/non-enclave-dev`, so the
# monitor accepts the mock attestations their guardian logs.
ARG FEATURES=""
RUN --network=none cargo build --release --frozen --target "$TARGET" -p hashi-monitor --bin hashi-monitor ${FEATURES:+--features "$FEATURES"}

#
# Build stage: compile with real source (only local crates recompile)
#
FROM deps AS build

COPY crates/hashi-monitor /src/crates/hashi-monitor
COPY crates/hashi-guardian /src/crates/hashi-guardian
COPY crates/hashi-types /src/crates/hashi-types

# Touch source files to invalidate cargo's fingerprint cache for local crates
RUN find crates/ -name "*.rs" -exec touch {} +

ARG FEATURES
RUN --network=none cargo build --release --frozen --target "$TARGET" -p hashi-monitor --bin hashi-monitor ${FEATURES:+--features "$FEATURES"}

#
# Package stage: minimal runtime image
#
FROM core-filesystem
# CA bundle for the AWS SDK's S3 client: aws-smithy verifies TLS through
# rustls-native-certs and core-filesystem ships no root store.
COPY --from=build /etc/ssl/cert.pem /etc/ssl/cert.pem
COPY --from=build /src/target/x86_64-unknown-linux-musl/release/hashi-monitor /usr/bin/hashi-monitor
ENTRYPOINT ["/usr/bin/hashi-monitor"]
